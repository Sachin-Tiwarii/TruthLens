# Copy this file to `.env` (same folder as docker-compose.yml) and fill in real values.
# docker compose reads .env automatically. Never commit the real .env.

# Secret used to sign JWT login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Add your deployed frontend URL here when you host it.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
